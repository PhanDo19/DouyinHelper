{
  "manifest_version": 3,
  "name": "Local Video Detector",
  "version": "0.1.0",
  "description": "Detects clear media requests and sends them to the local downloader app.",
  "permissions": [
    "alarms",
    "cookies",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Local Video Detector",
    "default_popup": "popup.html"
  }
}
